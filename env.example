# Hummingbot Dashboard - Environment Configuration
# ================================================
# Copy this file to .env and configure your settings
#
# cp env.example .env

# ==========================================
# Hummingbot Backend API Configuration
# ==========================================

# Backend API URL (Hummingbot Gateway)
# Default: http://localhost:8000
API_BASE=http://localhost:8000

# Hummingbot API Credentials
# These credentials are used for:
# - Proxying API requests to the Hummingbot backend
# - Scheduled portfolio analysis
HB_API_USERNAME=admin
HB_API_PASSWORD=your_password_here

# ==========================================
# AI Configuration (Gemini)
# ==========================================

# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/apikey
# Leave empty to disable AI features
GEMINI_API_KEY=

# ==========================================
# Application Settings
# ==========================================

# Environment mode
# production - optimized for production use
# development - enables hot reload and debug features
NODE_ENV=production

